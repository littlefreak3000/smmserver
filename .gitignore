# built programs and release packages (rebuild with: node tools/build-release.mjs)
/dist/
*.exe
*.exe~

# a server's data: catalogs, downloaded levels, keys, logs. Never commit these (secrets.json holds the server's keys)
/archive-live/
/data/
**/log/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# reference copies of other projects and downloaded samples
/repos/
/samples/

# tool dependencies
node_modules/
__pycache__/
*.pyc

# the one-level sample archive and the old stand-in's sample data (a downloaded level file; not ours to publish)
/archive/
/fake-s3/data/

# sample level files used by some tests (see server/*/testdata/README.md): kept on disk, never committed
/server/**/testdata/*.bin
/server/**/testdata/*.cdt
/server/**/testdata/*.meta
